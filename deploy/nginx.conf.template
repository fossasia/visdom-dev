proxy_cache_path /var/cache/nginx/auth levels=1:2 keys_zone=auth_cache:1m
                 max_size=10m inactive=60s use_temp_path=off;

set_real_ip_from 172.16.0.0/12;
real_ip_header X-Forwarded-For;

resolver 127.0.0.11 valid=10s ipv6=off;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types
    application/javascript
    application/json
    application/wasm
    application/xml
    image/svg+xml
    text/css
    text/javascript
    text/plain;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $request_uri $shard_key_path {
    default                       "";
    "~^/vis/w/(?<uri_slug>[^/]+)/" $uri_slug;
}

map $shard_key_path $shard_key {
    default $shard_key_path;
    ""      $http_x_visdom_workspace;
}

map $request_uri $auth_limit_key {
    default                    "";
    "~^/api/v1/auth/login"     $binary_remote_addr;
    "~^/api/v1/auth/register"  $binary_remote_addr;
}

limit_req_zone $auth_limit_key zone=auth_limit:10m rate=1r/s;
limit_req_status 429;

upstream console_gateway {
    server ${GATEWAY_HOST}:${GATEWAY_PORT};
}

upstream visdom_server {
    zone visdom_server 64k;
    hash $shard_key consistent;
    ${VISDOM_SERVERS}
}

server {
    listen ${NGINX_PORT};
    server_name _;

    absolute_redirect off;

    include /etc/nginx/security-headers.conf;

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location /assets/ {
        root /usr/share/nginx/html;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
        access_log off;
    }

    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store" always;
        include /etc/nginx/security-headers.conf;
    }

    location /api/v1/ {
        limit_req zone=auth_limit burst=5 nodelay;

        proxy_pass http://console_gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /_auth_verify {
        internal;
        proxy_pass http://console_gateway/api/v1/auth/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-API-KEY $http_x_api_key;

        proxy_cache auth_cache;
        proxy_cache_key "$cookie_session_token|$http_x_api_key";
        proxy_cache_valid 200 5s;
        proxy_cache_valid 401 403 5s;
        proxy_ignore_headers Set-Cookie Cache-Control Expires;
        proxy_hide_header Set-Cookie;
    }

    location ~ ^/vis/w/(?<ws_slug>[^/]+)/(?<vis_rest>.*)$ {
        auth_request /_auth_verify;
        error_page 401 = @auth_redirect;

        rewrite ^/vis/w/[^/]+/(.*)$ /vis/$1 break;
        proxy_pass http://visdom_server;
        proxy_http_version 1.1;
        proxy_connect_timeout 2s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_set_header X-Visdom-Workspace $ws_slug;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-cache" always;
        add_header X-Visdom-Upstream $upstream_addr always;
        include /etc/nginx/security-headers.conf;
    }

    location /vis/ {
        auth_request /_auth_verify;
        error_page 401 = @auth_redirect;

        proxy_pass http://visdom_server;
        proxy_http_version 1.1;
        proxy_connect_timeout 2s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;

        add_header X-Visdom-Upstream $upstream_addr always;
        include /etc/nginx/security-headers.conf;
    }

    location @auth_redirect {
        default_type application/json;
        if ($http_x_api_key) {
            return 401 '{"detail":"Invalid or expired API key"}';
        }
        return 302 /login?next=$request_uri;
    }
}
